{
  "name": "kids-animation-studio",
  "version": "0.1.0",
  "description": "Local web app that turns a topic into an Amharic or English kids animated video (poem -> scenes -> character -> Lyria song or narration -> clips -> MP4).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run ui:css && tsx src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json && npm run ui:css",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "ui:css": "tailwindcss -i src/api/ui/styles.css -o public/app.css --minify",
    "ui:css:watch": "tailwindcss -i src/api/ui/styles.css -o public/app.css --watch",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "dev": "npm run ui:css && tsx watch src/main.ts",
    "serve": "node dist/main.js"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.4",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "main": "dist/main.js"
}
