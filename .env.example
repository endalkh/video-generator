# Postgres used by Prisma (projects, prompts, prompt history, generation log)
DATABASE_URL="postgresql://USER@localhost:5432/kids_studio?schema=public"
# Optional: separate DB for the Prisma integration tests (they wipe it)
TEST_DATABASE_URL="postgresql://USER@localhost:5432/kids_studio_test?schema=public"

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# PORT=5178
# MEDIA_ROOT=output
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# GEMINI_MUSIC_MODEL=lyria-3-clip-preview

# docker compose (Postgres + pgAdmin + app). The app container builds its own DATABASE_URL
# from these, pointing at the `postgres` service with ?schema=public.
POSTGRES_USER=kids_studio
POSTGRES_DB=kids_studio
POSTGRES_PASSWORD=change-me
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
# Host ports (all bound to 127.0.0.1)
# APP_PORT=5178
# PGADMIN_PORT=5051
# POSTGRES_PORT=5433
