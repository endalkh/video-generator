generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  new
  running
  /// Manual mode: waiting for the user to review the last finished step.
  review
  paused
  done
  failed
}

/// One video project. Text artifacts live here as JSON; media files live on disk under output/<id>/.
model Project {
  id          String        @id
  topic       String
  input       Json
  provider    String
  status      ProjectStatus @default(new)
  error       String?
  completed   String[]      @default([])
  /// Manual mode: steps the user has reviewed and approved.
  approved    String[]      @default([])
  poem        Json?
  scenes      Json?
  character   Json?
  song        Json?
  /// YouTube upload info made at the end: title, description, tags, thumbnail text.
  publish     Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  generations Generation[]
  /// The channel (channel_kits.id) this video belongs to; null only for rows from before channels existed.
  channelId   String?       @map("channel_id")

  @@index([updatedAt(sort: Desc)])
  @@index([channelId, updatedAt(sort: Desc)])
  @@map("projects")
}

/// Current (editable) version of each prompt template. channelId "" = the shared prompt; otherwise a channel's own copy.
model Prompt {
  channelId String          @default("") @map("channel_id")
  key       String
  template  String
  version   Int             @default(1)
  updatedAt DateTime        @updatedAt @map("updated_at")
  versions  PromptVersion[]

  @@id([channelId, key])
  @@map("prompts")
}

/// Full history of every prompt edit, so changes can be reviewed and restored.
model PromptVersion {
  id        BigInt   @id @default(autoincrement())
  channelId String   @default("") @map("channel_id")
  key       String
  version   Int
  template  String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  prompt    Prompt   @relation(fields: [channelId, key], references: [channelId, key], onDelete: Cascade)

  @@unique([channelId, key, version])
  @@map("prompt_versions")
}

/// Every rendered prompt actually sent to a model, for debugging and tuning prompts.
model Generation {
  id            BigInt   @id @default(autoincrement())
  projectId     String   @map("project_id")
  step          String
  sceneIndex    Int?     @map("scene_index")
  promptKey     String   @map("prompt_key")
  promptVersion Int      @map("prompt_version")
  prompt        String
  provider      String
  /// Model that received the prompt ("" for rows created before models were tracked).
  model         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, id])
  @@map("generations")
}

/// Which AI model to use for each pipeline task (poem, scene plan, images, song, …). Edited on the Settings page.
model ModelSetting {
  task      String   @id
  model     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("model_settings")
}

/// A YouTube channel brand kit (Channel page). Pictures (logo, banner, …) live on disk under output/_channels/<id>/.
model ChannelKit {
  id        String   @id
  /// Name, brief (prompt), language, age range and art style.
  input     Json
  provider  String
  /// Channel name, handle, tagline, description and keywords.
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt(sort: Desc)])
  @@map("channel_kits")
}

/// A month of video ideas with posting dates/times (Ideas & schedule page). One row per channel and month.
model ContentPlan {
  channelId String   @default("") @map("channel_id")
  /// YYYY-MM
  month     String
  /// Channel, main character, language, posting days/times, time zone, notes.
  input     Json
  theme     String?
  /// Ideas in posting order: date, time, language, topic, audio mode, scenes, thumbnail title, description, tags, projectId.
  ideas     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([channelId, month])
  @@map("content_plans")
}
